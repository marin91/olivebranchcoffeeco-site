---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-olive-100 bg-moss text-cream-100">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 sm:grid-cols-2">
      <div>
        <p class="font-serif text-lg font-semibold text-cream-50">{site.name}</p>
        <p class="mt-2 text-sm text-olive-200">{site.tagline}</p>
        <p class="mt-6 text-sm text-olive-200">
          <a href={`mailto:${site.email}`} class="hover:text-cream-50">{site.email}</a><br />
          <a href={`tel:${site.phone}`} class="hover:text-cream-50">{site.phone}</a>
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-olive-300">Explore</p>
        <ul class="mt-4 space-y-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-olive-200 hover:text-cream-50">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-moss-600 pt-6 text-xs text-olive-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <span class="font-semibold uppercase tracking-[0.2em]">Follow us on social media</span>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-olive-300 hover:text-cream-50"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
