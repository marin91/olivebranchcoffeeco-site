---
import NewsletterSignup from './NewsletterSignup.tsx';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-olive-100 bg-olive-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 sm:grid-cols-3">
      <div>
        <p class="font-serif text-lg font-semibold text-cream-50">{site.name}</p>
        <p class="mt-2 text-sm text-olive-200">{site.tagline}</p>
        <p class="mt-6 text-sm text-olive-200">
          {site.address.line1}<br />
          {site.address.line2}
        </p>
        <p class="mt-4 text-sm text-olive-200">
          <a href={`mailto:${site.email}`} class="hover:text-cream-50">{site.email}</a><br />
          <a href={`tel:${site.phone}`} class="hover:text-cream-50">{site.phone}</a>
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-olive-300">Explore</p>
        <ul class="mt-4 space-y-2">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-olive-200 hover:text-cream-50">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-olive-300">Stay in the loop</p>
        <p class="mt-4 text-sm text-olive-200">
          New roasts, pop-up dates, and seasonal menu drops — once or twice a month.
        </p>
        <div class="mt-4">
          <NewsletterSignup client:visible />
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-olive-700 pt-6 text-xs text-olive-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-4">
        <a href={site.social.instagram} class="hover:text-cream-50">Instagram</a>
        <a href={site.social.facebook} class="hover:text-cream-50">Facebook</a>
      </div>
    </div>
  </div>
</footer>
