---
import MobileNav from './MobileNav.tsx';
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="relative border-b border-olive-100 bg-cream-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.jpg" alt={site.name} class="h-10 w-10 rounded-full" width="150" height="150" />
      <span class="font-serif text-xl font-semibold text-moss">{site.name}</span>
    </a>

    <nav class="hidden sm:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-sm text-sm font-medium tracking-wide text-olive-700 transition-colors hover:text-moss focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-moss focus-visible:ring-offset-2 focus-visible:ring-offset-cream-50',
                { 'text-moss underline underline-offset-4': currentPath === item.href },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 sm:flex">
      <a href="/events" class="btn-secondary">Book an Event</a>
      <a href="/order" class="btn-primary">Order Ahead</a>
    </div>

    <MobileNav items={nav} currentPath={currentPath} client:load />
  </div>
</header>
