---
import MobileNav from './MobileNav.tsx';
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="relative border-b border-olive-100 bg-cream-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="/" class="font-serif text-xl font-semibold text-olive-900">
      {site.name}
    </a>

    <nav class="hidden sm:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-sm font-medium tracking-wide text-olive-700 transition-colors hover:text-olive-900',
                { 'text-olive-900 underline underline-offset-4': currentPath === item.href },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/events" class="hidden sm:inline-flex btn-primary">
      Book an Event
    </a>

    <MobileNav items={nav} client:load />
  </div>
</header>
