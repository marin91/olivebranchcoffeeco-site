---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingEvents } from '../data/events';
import { site } from '../data/site';
---

<BaseLayout title="Events" description="Upcoming events at Olive Branch Coffee Co., and how to book us for yours.">
  <section class="section">
    <p class="eyebrow">Events</p>
    <h1 class="mt-3 text-4xl font-semibold">What's happening in the shop</h1>

    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {upcomingEvents.map((event) => (
        <li class="rounded-2xl border border-olive-100 bg-cream-100 p-6">
          <p class="text-sm font-medium text-clay-500">{event.date}</p>
          <h2 class="mt-2 font-serif text-xl text-olive-900">{event.title}</h2>
          <p class="mt-3 text-sm text-olive-700">{event.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section border-t border-olive-100">
    <div class="rounded-2xl bg-olive-800 p-10 text-cream-50 sm:p-14">
      <p class="eyebrow text-clay-400">Book Olive Branch</p>
      <h2 class="mt-3 text-3xl text-cream-50">Host your event with us</h2>
      <p class="mt-4 max-w-xl text-olive-200">
        We cater private gatherings, pop-ups, and small events, and can open the shop
        outside regular hours for larger groups. Every booking is reviewed and confirmed
        by the owner directly — online requests are coming soon.
      </p>
      <a href={`mailto:${site.email}?subject=Event booking inquiry`} class="btn-primary mt-6 inline-flex bg-clay-500 hover:bg-clay-600">
        Email us about your event
      </a>
    </div>
  </section>
</BaseLayout>
