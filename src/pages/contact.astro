---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Visit, call, or email Olive Branch Coffee Co. in Bristol, RI.">
  <section class="section grid gap-12 sm:grid-cols-2">
    <div>
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 text-4xl font-semibold">Come say hello</h1>
      <p class="mt-4 max-w-md text-olive-700">
        We're happy to answer questions about the menu, private events, or anything else.
      </p>

      <dl class="mt-10 space-y-6">
        <div>
          <dt class="eyebrow">Address</dt>
          <dd class="mt-2 text-olive-800">
            {site.address.line1}<br />
            {site.address.line2}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Hours</dt>
          <dd class="mt-2 space-y-1 text-olive-800">
            {site.hours.map((h) => (
              <p>{h.days}: {h.time}</p>
            ))}
          </dd>
        </div>
        <div>
          <dt class="eyebrow">Email & Phone</dt>
          <dd class="mt-2 text-olive-800">
            <a href={`mailto:${site.email}`} class="hover:text-clay-500">{site.email}</a><br />
            <a href={`tel:${site.phone}`} class="hover:text-clay-500">{site.phone}</a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="aspect-square w-full rounded-2xl bg-olive-200"></div>
  </section>
</BaseLayout>
