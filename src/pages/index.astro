---
import BaseLayout from '../layouts/BaseLayout.astro';
import { menu } from '../data/menu';
import { upcomingEvents } from '../data/events';

const featuredCategory = menu[0];
const nextEvent = upcomingEvents[0];
---

<BaseLayout title="Home" description="A neighborhood coffeehouse in Moreno Valley, CA — slow coffee, warm welcome.">
  <section class="section grid gap-10 sm:grid-cols-2 sm:items-center">
    <div>
      <p class="eyebrow">Moreno Valley, California</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">Slow coffee, warm welcome.</h1>
      <p class="mt-5 max-w-md text-base text-olive-700">
        Olive Branch Coffee Co. is a neighborhood coffeehouse serving thoughtfully sourced
        espresso, slow pour-overs, and food made from scratch every morning.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/menu" class="btn-primary">View the Menu</a>
        <a href="/events" class="btn-secondary">Book an Event</a>
      </div>
    </div>
    <div class="aspect-[4/3] w-full rounded-2xl bg-olive-200"></div>
  </section>

  <section class="section border-t border-olive-100">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <p class="eyebrow">On the menu</p>
        <h2 class="mt-3 text-3xl">{featuredCategory.title}</h2>
        <p class="mt-4 text-olive-700">
          Pulled slow, served warm. Explore the full menu for drip, pour-over, and food made
          in-house daily.
        </p>
        <a href="/menu" class="mt-6 inline-block text-sm font-semibold text-clay-500 hover:text-clay-600">
          See the full menu →
        </a>
      </div>
      <ul class="grid flex-1 gap-4 sm:grid-cols-2">
        {featuredCategory.items.map((item) => (
          <li class="rounded-xl border border-olive-100 bg-cream-100 p-5">
            <div class="flex items-baseline justify-between gap-3">
              <p class="font-serif text-lg text-olive-900">{item.name}</p>
              <p class="text-sm text-olive-600">{item.price}</p>
            </div>
            <p class="mt-1 text-sm text-olive-700">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section border-t border-olive-100">
    <div class="rounded-2xl bg-olive-800 p-10 text-cream-50 sm:p-14">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="eyebrow text-clay-400">Coming up</p>
          <h2 class="mt-2 text-2xl text-cream-50">{nextEvent.title}</h2>
          <p class="mt-1 text-sm text-olive-200">{nextEvent.date}</p>
          <p class="mt-3 max-w-md text-sm text-olive-200">{nextEvent.description}</p>
        </div>
        <a href="/events" class="btn-primary shrink-0 bg-clay-500 hover:bg-clay-600">
          See All Events
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
