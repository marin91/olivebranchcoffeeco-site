---
import BaseLayout from '../layouts/BaseLayout.astro';
import { menu } from '../data/menu';
---

<BaseLayout title="Menu" description="Espresso, drip, pour-over, and food made from scratch at Olive Branch Coffee Co.">
  <section class="section">
    <p class="eyebrow">Menu</p>
    <h1 class="mt-3 text-4xl font-semibold">What we're pouring</h1>
    <p class="mt-4 max-w-xl text-olive-700">
      Our menu changes with the seasons and whatever our roasters have on hand. Ask your
      barista about today's single-origin.
    </p>

    <div class="mt-12 space-y-14">
      {menu.map((category) => (
        <div>
          <h2 class="text-2xl">{category.title}</h2>
          <ul class="mt-6 divide-y divide-olive-100">
            {category.items.map((item) => (
              <li class="flex items-start justify-between gap-6 py-4">
                <div>
                  <p class="font-serif text-lg text-olive-900">{item.name}</p>
                  <p class="mt-1 text-sm text-olive-700">{item.description}</p>
                </div>
                <p class="shrink-0 text-sm font-medium text-olive-600">{item.price}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
